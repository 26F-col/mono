{
  "compilerOptions": {
    "types": ["mocha", "chai", "node"],
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["tests/**/*.ts", "sdk/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["app", "node_modules", "target"]
}

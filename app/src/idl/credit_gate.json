        "kind": "struct",
        "fields": [
          {
            "name": "attester",
            "type": "pubkey"
          }
        ]
      }
    },
    {
      "name": "ConcentrationParams",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "threshold_bps",
            "docs": [
              "A single asset above this weight of gross NAV is penalized (4000 = 40%)."
            ],
            "type": "u16"
          },
          {
            "name": "penalty_bps",
            "docs": [
              "Multiplier applied to the penalized asset's eligible value (7500 = 0.75)."
            ],
            "type": "u16"
          }
        ]
      }
    },
    {
      "name": "CreditFacility",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "gate",
            "type": "pubkey"
          },
          {
            "name": "vault",
            "type": "pubkey"
          },
          {
            "name": "institution",
            "type": "pubkey"
          },
          {
            "name": "outstanding_usdc",
            "type": "u64"
          },
          {
            "name": "margin_status",
            "type": "u8"
          },
          {
            "name": "last_credit_nonce",
            "docs": [
              "Strictly increasing: each credit draw must use a newer portfolio version."
            ],
            "type": "u64"
          },
          {
            "name": "last_status_nonce",
            "docs": [
              "Status reports may repeat the current version (>=) — e.g. repeated",
              "MARGIN_CALL monitoring between commits."
            ],
            "type": "u64"
          },
          {
            "name": "opened_slot",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "CreditGate",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "authority",
            "type": "pubkey"
          },
          {
            "name": "attester",
            "docs": [
              "Ed25519 public key of the trusted risk engine (prototype trust root)."
            ],
            "type": "pubkey"
          },
          {
            "name": "usdc_mint",
            "type": "pubkey"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "total_released_usdc",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "CreditReleased",
      "docs": [
        "Public: amount + vault only. Portfolio stays confidential."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "vault",
            "type": "pubkey"
          },
          {
            "name": "institution",
            "type": "pubkey"
          },
          {
            "name": "amount_usdc",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "GateInitialized",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "gate",
            "type": "pubkey"
          },
          {
            "name": "attester",
            "type": "pubkey"
          }
        ]
      }
    },
    {
      "name": "LoanRepaid",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "vault",
            "type": "pubkey"
          },
          {
            "name": "remaining_usdc",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "MarginStatusChanged",
      "docs": [
        "Public: \"additional collateral required\" style signal, no cause detail."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "vault",
            "type": "pubkey"
          },
          {
            "name": "status",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "PolicyAsset",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "mint",
            "type": "pubkey"
          },
          {
            "name": "advance_rate_bps",
            "docs": [
              "e.g. SPYx 8000 (80%), AAPLx 7000, NVDAx 6000 in the initial policy."
            ],
            "type": "u16"
          }
        ]
      }
    },
    {
      "name": "PolicyParams",
      "docs": [
        "Prototype risk parameters. These are DEMO ASSUMPTIONS, not production risk",
        "parameters. Kept in one account so they are configurable, not hard-coded."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "session",
            "type": {
              "defined": {
                "name": "SessionFactor"
              }
            }
          },
          {
            "name": "concentration",
            "type": {
              "defined": {
                "name": "ConcentrationParams"
              }
            }
          },
          {
            "name": "credit_hf_bps",
            "docs": [
              "Health-factor floor for releasing NEW credit and for staying COMPLIANT",
              "(20000 = 2.0x). Between this and `ineligible_hf_bps` the public",
              "status is MARGIN_CALL."
            ],
            "type": "u16"
          },
          {
            "name": "ineligible_hf_bps",
            "docs": [
              "Below this health factor the status is INELIGIBLE."
            ],
            "type": "u16"
          },
          {
            "name": "max_staleness_slots",
            "docs": [
              "Feed freshness window, in slots, taken from the oracle accounts."
            ],
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "RiskPolicy",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "policy_id",
            "type": {
              "array": [
                "u8",
                8
              ]
            }
          },
          {
            "name": "authority",
            "type": "pubkey"
          },
          {
            "name": "params",
            "type": {
              "defined": {
                "name": "PolicyParams"
              }
            }
          },
          {
            "name": "assets",
            "type": {
              "vec": {
                "defined": {
                  "name": "PolicyAsset"
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "SessionFactor",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "market_open_bps",
            "docs": [
              "Factor applied while the US equity market is open (e.g. 10000 = 1.00)."
            ],
            "type": "u16"
          },
          {
            "name": "extended_hours_bps",
            "docs": [
              "Extended/after-hours trading."
            ],
            "type": "u16"
          },
          {
            "name": "market_closed_bps",
            "docs": [
              "Underlying market closed (overnight, weekend)."
            ],
            "type": "u16"
          }
        ]
      }
    },
    {
      "name": "TreasuryFunded",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "amount",
            "type": "u64"
          }
        ]
      }
    },
    {
      "name": "Vault",
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "institution",
            "type": "pubkey"
          },
          {
            "name": "policy",
            "type": "pubkey"
          },
          {
            "name": "bump",
            "type": "u8"
          },
          {
            "name": "collateral_locked",
            "type": "bool"
          },
          {
            "name": "commitment",
            "docs": [
              "sha256 over the client-encrypted portfolio snapshot (32 zero bytes =",
              "no snapshot committed yet). This is the ONLY portfolio-derived data on",
              "chain: a commitment, not a disclosure."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "commitment_nonce",
            "docs": [
              "Program-counted snapshot version. Attestations must carry the current",
              "value, which both binds them to this portfolio state and makes them",
              "strictly non-replayable."
            ],
            "type": "u64"
          },
          {
            "name": "last_commit_slot",
            "type": "u64"
          },
          {
            "name": "deposit_count",
            "type": "u16"
          }
        ]
      }
    }
  ]
}
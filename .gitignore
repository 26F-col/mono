# build / toolchain
.anchor
target
node_modules
app/dist
tmp

# os / editor
.DS_Store
*.log
.env

# solana ledgers + local state (regenerated by scripts)
.demo-ledger*
.smoke-ledger*
.debug-ledger*
app/public/demo-state.json
app/public/localnet-state.json
app/public/devnet-state.json
app/public/localnet-state.json

# rust
**/*.rs.bk
app/public/devnet-state.json
.env.local
app/.env.local

# Circom & Zero-Knowledge Artifacts

# Intermediate compiler files & constraint systems
circuits/build/
*.r1cs
*.sym
*.wtns

# JS/WASM generated witness runners (transient build outputs)
circuits/src/*_js/
*_js/

# Trusted setup transcripts & large cryptographic keys
circuits/keys/
*.ptau
*.zkey

# Never ignore circuit source files or the tiny public verification key
!circuits/artifacts/verification_key.json
!circuits/src/**/*.circom
